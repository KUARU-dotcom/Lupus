(import lappland)
(import (texas net) :as net)

;; Инъекция 1.0 проверяется на всех Result-функциях texas.
(lappland/malice 1.0)
(lappland/delay 1.0)
(print (match (net/tcp-connect "127.0.0.1" 0)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/tcp-listen 0)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/accept none)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/send none "x")
  ((success _) "success")
  ((failure message) message)))
(print (match (net/recv none 1)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/recv-line none)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-bind 0)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-send-to none "127.0.0.1" 0 "x")
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-recv-from none 1)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/tcp-accept none)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/tcp-send none "x")
  ((success _) "success")
  ((failure message) message)))
(print (match (net/tcp-recv none 1)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-socket 0)
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-send none "127.0.0.1" 0 "x")
  ((success _) "success")
  ((failure message) message)))
(print (match (net/udp-recv none 1)
  ((success _) "success")
  ((failure message) message)))

;; close не возвращает Result, поэтому проверяется без инъекции.
(lappland/malice 0.0)
(define listener
  (match (net/tcp-listen 0)
    ((success value) value)
    ((failure message) (print message) (exit 1))))
(net/close listener)
(print "listener-closed")
(define socket
  (match (net/udp-bind 0)
    ((success value) value)
    ((failure message) (print message) (exit 1))))
(net/close socket)
(print "socket-closed")

;; Детерминированная последовательность при LUPUS_MALICE_SEED=42.
(define (probe)
  (match (net/tcp-connect "127.0.0.1" 0)
    ((success _) (print "open"))
    ((failure message)
      (print (if (= message "net: injected malice") "I" "N")))))
(lappland/malice 0.5)
(probe)
(probe)
(probe)
(probe)
(probe)
(probe)
(probe)
(probe)
