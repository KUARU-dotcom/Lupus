; V0.6: and/or возвращают значение, ложны только false и none.
(print (and 1 2 3))
(print (and 1 false 3))
(print (and 1 none 3))
(print (or false 0))
(print (or false none "x"))
(print (and))
(print (or))
(print (and false (/ 1 0)))
(print (or true (/ 1 0)))
(print (and 0 "" (list)))
(print (or false (list)))
(print (not 0))
(print (not ""))
(print (not none))
