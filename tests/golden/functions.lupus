(define (factorial n)
    (if (= n 0) 1 (* n (factorial (- n 1)))))
(print (factorial 7))
(print ((lambda (x) (* x x)) 5))
(define (make-counter)
    (define-mutable n 0)
    (lambda () (set! n (+ n 1)) n))
(define c (make-counter))
(c)
(c)
(print (c))
(print (if (< 2 3) 10 20))
(print (if (> 2 3) 10 20))
(print (and (> 5 3) (< 10 20)))
(print (or (> 5 10) (< 3 7)))
(print (not (= 5 3)))
(define-mutable s 0)
(define-mutable j 1)
(while (<= j 10)
    (set! s (+ s j))
    (set! j (+ j 1)))
(print s)
