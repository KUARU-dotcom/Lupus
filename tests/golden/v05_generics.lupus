(defstruct (Node a)
  (value a)
  (left (Option (Node a)))
  (right (Option (Node a))))
(define tree (Node 10 (some (Node 5 none none)) none))
(print tree)
(print (Node-value tree))
(print (node-value tree))
(print (match tree ((Node v _ _) v) (_ 0)))
(print (= (Node 1 none none) (Node 1 none none)))
