(import senko)
(print (senko/sqrt 16.0))
(print (senko/pow 2.0 8.0))
(print (senko/round 2.5))
(import kaltsit)
(print (kaltsit/exists? "stdlib/util.lupus"))
(print (kaltsit/is-dir? "stdlib"))
(match (kaltsit/mkdir "target/lupus_v05_golden")
  ((success _) (print "mkdir-ok"))
  ((failure m) (print m)))
(match (kaltsit/write-file "target/lupus_v05_golden/a.txt" "ab")
  ((success _) (print "write-ok"))
  ((failure m) (print m)))
(match (kaltsit/append-file "target/lupus_v05_golden/a.txt" "c")
  ((success _) (print "append-ok"))
  ((failure m) (print m)))
(match (kaltsit/read-file "target/lupus_v05_golden/a.txt")
  ((success s) (print s))
  ((failure m) (print m)))
(match (kaltsit/size "target/lupus_v05_golden/a.txt")
  ((success n) (print n))
  ((failure m) (print m)))
(print (kaltsit/list-dir "stdlib"))
(match (kaltsit/delete "target/lupus_v05_golden/a.txt")
  ((success _) (print "delete-ok"))
  ((failure m) (print m)))
